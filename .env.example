# ================================================================
# Rithanya Hospital Platform - Environment Configuration & Secrets
# ================================================================

# Application Mode & Port
NODE_ENV=production
PORT=5000

# ----------------------------------------------------------------
# Option A: GoDaddy Hosted MySQL Database (Automatic Injection)
# When a MySQL database is attached in GoDaddy hosting, these variables 
# are automatically set in the hosting environment. The backend
# automatically synthesizes the DATABASE_URL connection string from them.
# ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rithanya_db
DB_USER=rithanya_user
DB_PASSWORD=your_godaddy_db_password

# ----------------------------------------------------------------
# Option B: Direct Connection String (Used for Aiven / Cloud MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
# ----------------------------------------------------------------
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# ----------------------------------------------------------------
# Cryptographic Security Secrets (Keep confidential!)
# ----------------------------------------------------------------
# JWT Secret for Session & RBAC Authentication (min 32 characters)
JWT_SECRET=rithanya_hospital_secure_jwt_secret_2026_super_key_dpdp_9981

# AES-256 Secret Key for Field-Level Data Encryption at Rest (min 32 characters)
AES_SECRET_KEY=rithanya_hospital_aes_256_enc_secret_key_2026_safe

# Allowed CORS Origin (Domain where the hospital website is hosted)
CLIENT_ORIGIN=https://rithanyahospital.com
